# Shared defaults - loaded for all environments
# Copy this file to env.base and fill your values. env.base is gitignored.
BITBUCKET_URL=https://bitbucket.org
BITBUCKET_WORKSPACE=my_org_web_dev
# App password (username + token, basic auth) OR PAT (token as Bearer).
# Bitbucket Cloud: https://bitbucket.org/account/settings/app-passwords/
BITBUCKET_TOKEN=
BITBUCKET_USERNAME=
# Repos relevantes, separados por coma. Vacío = todos los repos del workspace.
BITBUCKET_REPOS=
# Prefijos de nombre de proyecto (slugs que empiezan con x). Vacío = todos.
# Limita qué repos se escanean (p. ej. my, orders, billing) separados por coma.
BITBUCKET_PROJECT_PREFIXES=
# Slugs de repo a excluir siempre del descubrimiento (blacklist), separados por coma.
# Se aplican aunque el repo empiece con un prefijo de proyecto. Vacío = ninguno.
BITBUCKET_EXCLUDE_REPOS=
# Rama base contra la que se hace el diff (master, main, ...)
BITBUCKET_DEFAULT_BRANCH=master
# Prefijos de rutas SSM detectadas en el diff (p. ej. /config/backend, /config/common)
# Separados por coma. Vacio = se detectan los prefijos estandar.
SSM_PREFIXES=/config,/common
# --- CircleCI (deploys programados por commit) ---
# Token de usuario: https://app.circleci.com/settings/user/tokens
CIRCLECI_TOKEN=
# Project slug de CircleCI: {vcs}/{org}/{repo} (p. ej. bb/my_org_web_dev/bbit-test-01)
CIRCLECI_VCS=bb
CIRCLECI_ORG=my_org_web_dev
# Prefijos de tags/deploy a mostrar en columnas separadas (uat, stgp, prod, ...)
DEPLOY_PREFIXES=uat,stgp,prod